import LoopSubgroups.Matrix.Defs

/-!
# Generators of the principal congruence subgroup of level two

Remark 6 and Corollary 7 of the paper.
-/

open Matrix

namespace LoopSubgroups

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-! Auxiliary lemmas for the Euclidean algorithm with even multipliers. -/

namespace Gamma2Aux

lemma euclid (u v : ℤ) (hv : v ≠ 0) (h : v.natAbs < u.natAbs) :
    ∃ c : ℤ, c % 2 = 0 ∧ (u + c * v).natAbs < u.natAbs := by
  rcases lt_or_gt_of_ne hv with hv | hv <;> rcases le_or_gt 0 u with hu | hu
  · exact ⟨2, by omega⟩
  · exact ⟨-2, by omega⟩
  · exact ⟨-2, by omega⟩
  · exact ⟨2, by omega⟩

lemma X_mul_apply {a b : ι} (hab : a ≠ b) (c : ℤ) (B : Matrix ι ι ℤ) (i j : ι) :
    ((X hab c : GL ι ℤ) * B : Matrix ι ι ℤ) i j = B i j + if i = a then c * B b j else 0 := by
  rw [TauCeti.coe_transvectionUnit_eq_one_add_single, Matrix.add_mul, Matrix.one_mul]
  by_cases h : i = a
  · subst h; simp [single_mul_apply_same]
  · simp [h]

lemma mul_X_apply {a b : ι} (hab : a ≠ b) (c : ℤ) (B : Matrix ι ι ℤ) (i j : ι) :
    (B * (X hab c : GL ι ℤ) : Matrix ι ι ℤ) i j = B i j + if j = b then B i a * c else 0 := by
  rw [TauCeti.coe_transvectionUnit_eq_one_add_single, Matrix.mul_add, Matrix.mul_one]
  by_cases h : j = b
  · subst h; simp [mul_single_apply_same]
  · simp [mul_single_apply_of_ne (hbj := h), h]

lemma T_mul_apply (p : ι) (B : Matrix ι ι ℤ) (i j : ι) :
    ((T p : GL ι ℤ) * B : Matrix ι ι ℤ) i j = if i = p then -B i j else B i j := by
  change (diagonal (Function.update (1 : ι → ℤ) p (-1)) * B : Matrix ι ι ℤ) i j = _
  rw [diagonal_mul]
  by_cases h : i = p <;> simp [h]

lemma mem_Γ₂_iff (A : GL ι ℤ) :
    A ∈ Γ₂ ↔ ∀ i j, (((A : Matrix ι ι ℤ) i j : ℤ) : ZMod 2) = if i = j then 1 else 0 := by
  rw [Γ₂, MonoidHom.mem_ker, Units.ext_iff]
  rw [← Matrix.ext_iff]
  simp [Matrix.one_apply]

lemma diag_odd {A : GL ι ℤ} (hA : A ∈ Γ₂) (i : ι) : (A : Matrix ι ι ℤ) i i % 2 = 1 := by
  have h := (mem_Γ₂_iff A).1 hA i i
  simp only [↓reduceIte] at h
  rw [← Int.cast_one, ZMod.intCast_eq_intCast_iff'] at h
  simpa using h

lemma off_even {A : GL ι ℤ} (hA : A ∈ Γ₂) {i j : ι} (hij : i ≠ j) :
    (A : Matrix ι ι ℤ) i j % 2 = 0 := by
  have h := (mem_Γ₂_iff A).1 hA i j
  simp only [hij, ↓reduceIte] at h
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h
  push_cast at h
  omega

/-- The subgroup generated by the generators of Remark 6. -/
local notation "K" => Subgroup.closure (gamma2Gens (ι := ι))

lemma X_mem {a b : ι} (hab : a ≠ b) {c : ℤ} (hc : c % 2 = 0) : X hab c ∈ K := by
  obtain ⟨m, rfl⟩ : ∃ m, c = m * 2 := ⟨c / 2, by omega⟩
  have h : X hab (m * 2) = TauCeti.transvectionHom hab (Multiplicative.ofAdd (m • (2 : ℤ))) := by
    simp [mul_comm]
  rw [h, ofAdd_zsmul, map_zpow]
  exact zpow_mem (Subgroup.subset_closure (Or.inl ⟨a, b, hab, rfl⟩)) _

lemma T_mem (p : ι) : (T p : GL ι ℤ) ∈ K :=
  Subgroup.subset_closure (Or.inr ⟨p, rfl⟩)

lemma K_le : K ≤ (Γ₂ : Subgroup (GL ι ℤ)) := by
  rw [Subgroup.closure_le]
  rintro M (⟨a, b, hab, rfl⟩ | ⟨p, rfl⟩)
  · change reduce _ = 1
    rw [reduce, TauCeti.map_transvectionUnit]
    have : ((Int.castRingHom (ZMod 2)) 2) = 0 := by decide
    rw [this, TauCeti.transvectionUnit_zero]
  · rw [SetLike.mem_coe, mem_Γ₂_iff]
    intro i j
    change (((diagonal (Function.update (1 : ι → ℤ) p (-1)) : Matrix ι ι ℤ) i j : ℤ) : ZMod 2) = _
    by_cases hij : i = j
    · subst hij
      by_cases hip : i = p
      · subst hip; simp
      · simp [hip]
    · simp [hij]

/-- Column and row `g` of `A` are those of the identity matrix. -/
def Good (A : Matrix ι ι ℤ) (g : ι) : Prop :=
  (∀ k, A k g = (1 : Matrix ι ι ℤ) k g) ∧ (∀ k, A g k = (1 : Matrix ι ι ℤ) g k)

lemma good_X_mul {B : Matrix ι ι ℤ} {g a b : ι} (hab : a ≠ b) (c : ℤ) (hg : Good B g)
    (hga : g ≠ a) (hgb : g ≠ b) : Good ((X hab c : GL ι ℤ) * B : Matrix ι ι ℤ) g := by
  constructor <;> intro k <;> rw [X_mul_apply]
  · simp [hg.1, Ne.symm hgb]
  · simp [hg.2, hga]

lemma good_mul_X {B : Matrix ι ι ℤ} {g a b : ι} (hab : a ≠ b) (c : ℤ) (hg : Good B g)
    (hga : g ≠ a) (hgb : g ≠ b) : Good (B * (X hab c : GL ι ℤ) : Matrix ι ι ℤ) g := by
  constructor <;> intro k <;> rw [mul_X_apply]
  · simp [hg.1, hgb]
  · simp [hg.2, hga]

lemma good_T_mul {B : Matrix ι ι ℤ} {g p : ι} (hg : Good B g) (hgp : g ≠ p) :
    Good ((T p : GL ι ℤ) * B : Matrix ι ι ℤ) g := by
  constructor <;> intro k <;> rw [T_mul_apply]
  · by_cases hk : k = p
    · subst hk; simp [hg.1, Ne.symm hgp]
    · simp [hk, hg.1]
  · simp [hgp, hg.2]

lemma rowStep (p : ι) (G : ι → Prop)
    (hQ : ∀ B : GL ι ℤ, B ∈ Γ₂ → (∀ g, G g → Good (B : Matrix ι ι ℤ) g) →
      Good (B : Matrix ι ι ℤ) p → B ∈ K) :
    ∀ (n : ℕ) (B : GL ι ℤ), B ∈ Γ₂ → (∀ g, G g → Good (B : Matrix ι ι ℤ) g) →
      (∀ k, (B : Matrix ι ι ℤ) k p = (1 : Matrix ι ι ℤ) k p) →
      (Finset.univ.filter (fun q => (B : Matrix ι ι ℤ) p q ≠ (1 : Matrix ι ι ℤ) p q)).card = n →
      B ∈ K := by
  intro n
  induction n with
  | zero =>
    intro B hB hG hcol hn
    refine hQ B hB hG ⟨hcol, fun k => ?_⟩
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff] at hn
    simpa using hn (Finset.mem_univ k)
  | succ n ih =>
    intro B hB hG hcol hn
    obtain ⟨q, hq⟩ : ∃ q, q ∈ Finset.univ.filter
        (fun q => (B : Matrix ι ι ℤ) p q ≠ (1 : Matrix ι ι ℤ) p q) :=
      Finset.card_pos.1 (by omega)
    have hq' : (B : Matrix ι ι ℤ) p q ≠ (1 : Matrix ι ι ℤ) p q := (Finset.mem_filter.1 hq).2
    have hpq : p ≠ q := by rintro rfl; exact hq' (hcol p)
    have hc : (-(B : Matrix ι ι ℤ) p q) % 2 = 0 := by have := off_even hB hpq; omega
    have hpp : (B : Matrix ι ι ℤ) p p = 1 := by simpa using hcol p
    have hXK := X_mem hpq hc
    have hB' : B * X hpq (-(B : Matrix ι ι ℤ) p q) ∈ K := by
      refine ih _ (Subgroup.mul_mem _ hB (K_le hXK)) (fun g hg => ?_) (fun k => ?_) ?_
      · have hgB := hG g hg
        rw [Units.val_mul]
        refine good_mul_X hpq _ hgB ?_ ?_
        · rintro rfl; exact hq' (hgB.2 q)
        · rintro rfl; exact hq' (hgB.1 p)
      · rw [Units.val_mul, mul_X_apply, hcol k]
        simp [hpq]
      · rw [← Nat.add_right_cancel_iff (n := 1), ← hn, ← Finset.card_erase_add_one hq]
        congr 2
        ext j
        simp only [Units.val_mul, mul_X_apply, hpp, Finset.mem_filter, Finset.mem_univ,
          true_and, Finset.mem_erase]
        by_cases hj : j = q
        · subst hj; simp [hpq]
        · simp [hj]
    simpa only [mul_inv_cancel_right] using Subgroup.mul_mem _ hB' (Subgroup.inv_mem _ hXK)

lemma colStep (p : ι) (G : ι → Prop)
    (hrow : ∀ B : GL ι ℤ, B ∈ Γ₂ → (∀ g, G g → Good (B : Matrix ι ι ℤ) g) →
      (∀ k, (B : Matrix ι ι ℤ) k p = (1 : Matrix ι ι ℤ) k p) → B ∈ K) :
    ∀ (n : ℕ) (B : GL ι ℤ), B ∈ Γ₂ → (∀ g, G g → Good (B : Matrix ι ι ℤ) g) →
      ∑ k, ((B : Matrix ι ι ℤ) k p).natAbs = n → B ∈ K := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro B hB hG hn
  by_cases hcol : ∃ q, q ≠ p ∧ (B : Matrix ι ι ℤ) q p ≠ 0
  · obtain ⟨q, hqp, hq⟩ := hcol
    have hGq : ∀ g, G g → g ≠ q ∧ g ≠ p := by
      intro g hg
      have hgB := hG g hg
      constructor
      · rintro rfl; exact hq (by simpa [hqp] using hgB.2 p)
      · rintro rfl; exact hq (by simpa [hqp] using hgB.1 q)
    have hx := diag_odd hB p
    have hy := off_even hB hqp
    suffices ∃ (a b : ι) (hab : a ≠ b) (c : ℤ), c % 2 = 0 ∧ (∀ g, G g → g ≠ a ∧ g ≠ b) ∧
        ∑ k, ((((X hab c * B : GL ι ℤ)) : Matrix ι ι ℤ) k p).natAbs < n by
      obtain ⟨a, b, hab, c, hc, hab', hlt⟩ := this
      have hXK := X_mem hab hc
      have h1 : X hab c * B ∈ K := ih _ hlt _ (Subgroup.mul_mem _ (K_le hXK) hB)
        (fun g hg => by
          rw [Units.val_mul]
          exact good_X_mul hab c (hG g hg) (hab' g hg).1 (hab' g hg).2) rfl
      simpa only [inv_mul_cancel_left] using Subgroup.mul_mem _ (Subgroup.inv_mem _ hXK) h1
    -- the sum decreases if one entry decreases
    have key : ∀ (a b : ι) (hab : a ≠ b) (c : ℤ),
        ((B : Matrix ι ι ℤ) a p + c * (B : Matrix ι ι ℤ) b p).natAbs <
          ((B : Matrix ι ι ℤ) a p).natAbs →
        ∑ k, ((((X hab c * B : GL ι ℤ)) : Matrix ι ι ℤ) k p).natAbs < n := by
      intro a b hab c hlt
      rw [← hn]
      apply Finset.sum_lt_sum
      · intro k _
        rw [Units.val_mul, X_mul_apply]
        by_cases hk : k = a
        · subst hk; simpa using hlt.le
        · simp [hk]
      · exact ⟨a, Finset.mem_univ _, by rw [Units.val_mul, X_mul_apply]; simpa using hlt⟩
    rcases lt_or_gt_of_ne (show ((B : Matrix ι ι ℤ) q p).natAbs ≠
        ((B : Matrix ι ι ℤ) p p).natAbs by omega) with h | h
    · obtain ⟨c, hc, hlt⟩ := euclid _ _ hq h
      exact ⟨p, q, hqp.symm, c, hc, fun g hg => ⟨(hGq g hg).2, (hGq g hg).1⟩,
        key p q hqp.symm c hlt⟩
    · obtain ⟨c, hc, hlt⟩ := euclid _ _ (by omega) h
      exact ⟨q, p, hqp, c, hc, hGq, key q p hqp c hlt⟩
  · push Not at hcol
    have hunit : IsUnit ((B : Matrix ι ι ℤ) p p) := by
      have h := congrFun (congrFun B.inv_mul p) p
      rw [Matrix.mul_apply, Finset.sum_eq_single p (fun k _ hk => by rw [hcol k hk, mul_zero])
        (by simp)] at h
      exact IsUnit.of_mul_eq_one_right _ (by simpa using h)
    rcases Int.isUnit_iff.1 hunit with h1 | h1
    · refine hrow B hB hG fun k => ?_
      by_cases hk : k = p
      · subst hk; simpa using h1
      · simp [hcol k hk, hk]
    · have hTB : T p * B ∈ K := by
        refine hrow _ (Subgroup.mul_mem _ (K_le (T_mem p)) hB) (fun g hg => ?_) fun k => ?_
        · rw [Units.val_mul]
          refine good_T_mul (hG g hg) ?_
          rintro rfl
          have := (hG g hg).1 g
          simp [h1] at this
        · rw [Units.val_mul, T_mul_apply]
          by_cases hk : k = p
          · subst hk; simp [h1]
          · simp [hcol k hk, hk]
      simpa only [inv_mul_cancel_left] using Subgroup.mul_mem _ (Subgroup.inv_mem _ (T_mem p)) hTB

lemma Γ₂_le_K : (Γ₂ : Subgroup (GL ι ℤ)) ≤ K := by
  classical
  intro A hA
  suffices ∀ (n : ℕ) (A : GL ι ℤ), A ∈ Γ₂ →
      (Finset.univ.filter (fun g => ¬ Good (A : Matrix ι ι ℤ) g)).card = n → A ∈ K from
    this _ A hA rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro A hA hn
  by_cases hall : ∀ g, Good (A : Matrix ι ι ℤ) g
  · have : A = 1 := Units.ext (Matrix.ext fun i j => (hall j).1 i)
    rw [this]; exact Subgroup.one_mem _
  push Not at hall
  obtain ⟨p, hp⟩ := hall
  have hQ : ∀ B : GL ι ℤ, B ∈ Γ₂ → (∀ g, Good (A : Matrix ι ι ℤ) g → Good (B : Matrix ι ι ℤ) g) →
      Good (B : Matrix ι ι ℤ) p → B ∈ K := by
    intro B hB hG hBp
    refine ih _ ?_ B hB rfl
    rw [← hn]
    apply Finset.card_lt_card
    rw [Finset.ssubset_iff_of_subset]
    · exact ⟨p, by simp [hp], by simp [hBp]⟩
    · intro g
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact mt (hG g)
  exact colStep p _ (fun B hB hG hcol => rowStep p _ hQ _ B hB hG hcol rfl) _ A hA
    (fun g h => h) rfl

end Gamma2Aux

open Gamma2Aux

/-- **Remark 6.** `Γ₂` is generated by the squares `X_ij^2` of elementary matrices and the
diagonal matrices `T_i`. (Proof: Euclidean algorithm with even multipliers.) -/
theorem closure_gamma2Gens : Subgroup.closure (gamma2Gens (ι := ι)) = Γ₂ :=
  le_antisymm K_le Γ₂_le_K

/-- **Remark 6**, in the form used later: a subgroup containing all `X_ij^2` and all `T_i`
contains `Γ₂`. -/
theorem Γ₂_le_of_gens (H : Subgroup (GL ι ℤ))
    (hX : ∀ (i j : ι) (hij : i ≠ j), X hij (2 : ℤ) ∈ H) (hT : ∀ i, (T i : GL ι ℤ) ∈ H) :
    Γ₂ ≤ H := by
  rw [← closure_gamma2Gens, Subgroup.closure_le]
  rintro M (⟨a, b, hab, rfl⟩ | ⟨p, rfl⟩)
  · exact hX a b hab
  · exact hT p

/-- **Corollary 7.** For a fixed `i`, the set `{X_ik} ∪ {X_ji^2} ∪ {T_j}` generates a superset of
`Γ₂`. -/
theorem Γ₂_le_of_gens' (H : Subgroup (GL ι ℤ)) (i : ι)
    (h₁ : ∀ (k : ι) (hik : i ≠ k), X hik (1 : ℤ) ∈ H)
    (h₂ : ∀ (j : ι) (hji : j ≠ i), X hji (2 : ℤ) ∈ H) (hT : ∀ j, (T j : GL ι ℤ) ∈ H) :
    Γ₂ ≤ H := by
  refine Γ₂_le_of_gens H (fun a b hab => ?_) hT
  by_cases ha : a = i
  · subst ha
    have h := Subgroup.mul_mem _ (h₁ b hab) (h₁ b hab)
    rwa [← TauCeti.transvectionUnit_add, one_add_one_eq_two] at h
  by_cases hb : b = i
  · subst hb
    exact h₂ a hab
  · have h := TauCeti.commutatorElement_transvectionUnit ha (Ne.symm hb) hab (2 : ℤ) 1
    rw [mul_one] at h
    change TauCeti.transvectionUnit hab (2 : ℤ) ∈ H
    rw [← h, commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (h₂ a ha) (h₁ b (Ne.symm hb)))
      (Subgroup.inv_mem _ (h₂ a ha))) (Subgroup.inv_mem _ (h₁ b (Ne.symm hb)))

end LoopSubgroups
