import Mathlib

/-!
# Generators of the intersection with an index two subgroup (thesis, Lemma `index2intersection`)
-/

namespace LoopSubgroups

/-- **Lemma `index2intersection`.** Let `S ≤ G` have index two and `U = ⟨A⟩` with `h₁ ∈ A \ S`.
Then `U ∩ S` is generated by `h²`, `h h₁⁻¹` for `h ∈ A \ S` and `h`, `h₁ h h₁⁻¹` for `h ∈ A ∩ S`. -/
theorem closure_inf_of_index_eq_two {G : Type*} [Group G] {S : Subgroup G} (hS : S.index = 2)
    (A : Set G) {h₁ : G} (h₁A : h₁ ∈ A) (h₁S : h₁ ∉ S) :
    Subgroup.closure A ⊓ S =
      Subgroup.closure ((fun h => h ^ 2) '' (A \ S) ∪ (fun h => h * h₁⁻¹) '' (A \ S) ∪
        (A ∩ S) ∪ (fun h => h₁ * h * h₁⁻¹) '' (A ∩ S)) := by
  set K := Subgroup.closure ((fun h => h ^ 2) '' (A \ S) ∪ (fun h => h * h₁⁻¹) '' (A \ S) ∪
        (A ∩ S) ∪ (fun h => h₁ * h * h₁⁻¹) '' (A ∩ S)) with hK
  have hsq : ∀ a ∈ A, a ∉ S → a ^ 2 ∈ K := fun a ha haS =>
    Subgroup.subset_closure (Or.inl (Or.inl (Or.inl ⟨a, ⟨ha, haS⟩, rfl⟩)))
  have hmi : ∀ a ∈ A, a ∉ S → a * h₁⁻¹ ∈ K := fun a ha haS =>
    Subgroup.subset_closure (Or.inl (Or.inl (Or.inr ⟨a, ⟨ha, haS⟩, rfl⟩)))
  have hin : ∀ a ∈ A, a ∈ S → a ∈ K := fun a ha haS =>
    Subgroup.subset_closure (Or.inl (Or.inr ⟨ha, haS⟩))
  have hconj : ∀ a ∈ A, a ∈ S → h₁ * a * h₁⁻¹ ∈ K := fun a ha haS =>
    Subgroup.subset_closure (Or.inr ⟨a, ⟨ha, haS⟩, rfl⟩)
  have hKS : K ≤ S := by
    rw [hK, Subgroup.closure_le]
    rintro x (((⟨a, -, rfl⟩ | ⟨a, ⟨-, haS⟩, rfl⟩) | ⟨-, hx⟩) | ⟨a, ⟨-, haS⟩, rfl⟩)
    · exact Subgroup.sq_mem_of_index_two hS a
    · exact (Subgroup.mul_mem_iff_of_index_two hS).2 (iff_of_false haS (by simpa using h₁S))
    · exact hx
    · exact (Subgroup.normal_of_index_eq_two hS).conj_mem a haS h₁
  have hKA : K ≤ Subgroup.closure A := by
    have := Subgroup.subset_closure (k := A)
    rw [hK, Subgroup.closure_le]
    rintro x (((⟨a, ⟨ha, -⟩, rfl⟩ | ⟨a, ⟨ha, -⟩, rfl⟩) | ⟨ha, -⟩) | ⟨a, ⟨ha, -⟩, rfl⟩)
    · exact pow_mem (this ha) 2
    · exact mul_mem (this ha) (inv_mem (this h₁A))
    · exact this ha
    · exact mul_mem (mul_mem (this h₁A) (this ha)) (inv_mem (this h₁A))
  -- `h₁ * a ∈ K` for `a ∈ A \ S`
  have hla : ∀ a ∈ A, a ∉ S → h₁ * a ∈ K := fun a ha haS => by
    have := mul_mem (inv_mem (hmi a ha haS)) (hsq a ha haS)
    simpa [pow_two, mul_assoc] using this
  apply le_antisymm
  · rintro u ⟨hu, huS⟩
    have key : u ∈ K ∨ u * h₁⁻¹ ∈ K := by
      clear huS
      induction hu using Subgroup.closure_induction_right with
      | one => exact Or.inl (one_mem _)
      | mul_right v _ a ha ih =>
        by_cases haS : a ∈ S
        · rcases ih with ih | ih
          · exact Or.inl (mul_mem ih (hin a ha haS))
          · right
            have := mul_mem ih (hconj a ha haS)
            simpa [mul_assoc] using this
        · rcases ih with ih | ih
          · right
            have := mul_mem ih (hmi a ha haS)
            simpa [mul_assoc] using this
          · left
            have := mul_mem ih (hla a ha haS)
            simpa [mul_assoc] using this
      | mul_inv_cancel v _ a ha ih =>
        by_cases haS : a ∈ S
        · rcases ih with ih | ih
          · exact Or.inl (mul_mem ih (inv_mem (hin a ha haS)))
          · right
            have := mul_mem ih (inv_mem (hconj a ha haS))
            simpa [mul_assoc] using this
        · rcases ih with ih | ih
          · right
            have := mul_mem ih (inv_mem (hla a ha haS))
            simpa [mul_assoc] using this
          · left
            have := mul_mem ih (inv_mem (hmi a ha haS))
            simpa [mul_assoc] using this
    rcases key with h | h
    · exact h
    · exact absurd ((Subgroup.mul_mem_cancel_left S huS).1 (hKS h)) (by simpa using h₁S)
  · exact le_inf hKA hKS

end LoopSubgroups
